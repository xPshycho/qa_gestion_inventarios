log_format inventory_safe
  '$remote_addr [$time_local] '
  '"$request_method $uri $server_protocol" $status $body_bytes_sent '
  '"$http_user_agent"';

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name ${PRODUCTION_PUBLIC_IP};
  server_tokens off;
  access_log /var/log/nginx/access.log inventory_safe;

  if ($host != "${PRODUCTION_PUBLIC_IP}") {
    return 444;
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://${PRODUCTION_PUBLIC_IP}$request_uri;
  }
}

server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  http2 on;
  server_name ${PRODUCTION_PUBLIC_IP};
  server_tokens off;
  access_log /var/log/nginx/access.log inventory_safe;

  if ($host != "${PRODUCTION_PUBLIC_IP}") {
    return 444;
  }

  ssl_certificate /etc/letsencrypt/live/${TLS_CERTIFICATE_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${TLS_CERTIFICATE_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:inventory_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 10m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  # Keycloak's same-origin session/status iframes are required by keycloak-js.
  # The frontend still prevents framing through its own CSP frame-ancestors.
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location = /gateway-health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /api {
    return 308 /api/;
  }

  location = /api/actuator/prometheus {
    return 404;
  }

  location ^~ /api/actuator/prometheus/ {
    return 404;
  }

  location /api/ {
    proxy_pass http://backend:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_redirect off;
  }

  location = /auth {
    return 308 /auth/;
  }

  location = /auth/admin {
    return 404;
  }

  location ^~ /auth/admin/ {
    return 404;
  }

  location = /auth/realms/master {
    return 404;
  }

  location ^~ /auth/realms/master/ {
    return 404;
  }

  location /auth/ {
    proxy_pass http://keycloak:8080/;
    proxy_http_version 1.1;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Original-Forwarded-For "";
    proxy_set_header X-Original-URL "";
    proxy_set_header X-Original-Method "";
    proxy_set_header X-Forwarded-Access-Token "";
    proxy_set_header traceparent "";
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header b3 "";
    proxy_set_header X-B3-TraceId "";
    proxy_set_header X-B3-SpanId "";
    proxy_set_header X-B3-ParentSpanId "";
    proxy_set_header X-B3-Sampled "";
    proxy_set_header X-B3-Flags "";
    proxy_set_header uber-trace-id "";
    proxy_set_header X-OT-Span-Context "";
    proxy_redirect off;
  }

  location = /grafana {
    return 308 /grafana/;
  }

  location /grafana/ {
    proxy_pass http://grafana:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_redirect off;
  }

  location / {
    proxy_pass http://frontend:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_redirect off;
  }
}
