otelcol.receiver.otlp "inventory" {
	grpc { }

	http { }

	output {
		traces = [otelcol.processor.batch.inventory.input]
	}
}

otelcol.processor.batch "inventory" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

discovery.docker "inventory" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "inventory" {
	targets = discovery.docker.inventory.targets

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = sys.env("COMPOSE_PROJECT_NAME")
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_inventory_deployment_id"]
		target_label  = "deployment_id"
	}
}

loki.source.docker "inventory" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.inventory.output
	forward_to = [loki.process.inventory.receiver]
}

loki.process "inventory" {
	stage.docker { }

	stage.regex {
		expression = "traceId=(?P<traceId>[a-f0-9]{32}|-) spanId=(?P<spanId>[a-f0-9]{16}|-) correlationId=(?P<correlationId>[^ ]+)"
	}

	stage.structured_metadata {
		values = {
			traceId       = "",
			spanId        = "",
			correlationId = "",
		}
	}
	forward_to = [loki.write.inventory.receiver]
}

loki.write "inventory" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
