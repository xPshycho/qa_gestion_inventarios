# Contrato de variables para el despliegue persistente de producción en GCP.
# No use este archivo directamente: scripts/gcp/init-env.sh genera
# .production/production.env con permisos 0600, preservando los secretos.
#
# En la VM, PRODUCTION_STATE_DIR, PRODUCTION_ENV_FILE y
# PRODUCTION_EVIDENCE_DIR pueden apuntar a /opt/inventory/shared para mantener
# el estado fuera de cada release. Esas tres rutas son variables del proceso
# que ejecuta los scripts y no se guardan en este archivo.

COMPOSE_PROJECT_NAME=inventory-production
APP_VERSION=replace-with-full-git-sha
DEPLOYED_SHA=replace-with-full-git-sha
PRODUCTION_DEPLOYMENT_ID=replace-with-run-id

PRODUCTION_PUBLIC_IP=34.123.136.144
PRODUCTION_ORIGIN=https://34.123.136.144
PRODUCTION_FRONTEND_URL=https://34.123.136.144
PRODUCTION_BACKEND_URL=https://34.123.136.144/api
PRODUCTION_KEYCLOAK_URL=https://34.123.136.144/auth
PRODUCTION_GRAFANA_URL=https://34.123.136.144/grafana
TLS_CERTIFICATE_NAME=34.123.136.144

POSTGRES_DB=inventory
POSTGRES_USER=inventory_production
POSTGRES_PASSWORD=

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak_production
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=production-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=inventory
KEYCLOAK_CLIENT_ID=inventory-frontend
KEYCLOAK_ADMIN_CLIENT_ID=inventory-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_IMPORT_DIR=.production/keycloak

E2E_ADMIN_USERNAME=carlos
E2E_ADMIN_PASSWORD=
E2E_OPERATOR_USERNAME=edwin
E2E_OPERATOR_PASSWORD=
E2E_VIEWER_USERNAME=viewer
E2E_VIEWER_PASSWORD=
E2E_AUDITOR_USERNAME=auditor
E2E_AUDITOR_PASSWORD=

GRAFANA_ADMIN_USER=production-admin
GRAFANA_ADMIN_PASSWORD=

INVENTORY_CORS_ALLOWED_ORIGINS=https://34.123.136.144
OTEL_SDK_DISABLED=false
OTEL_DEPLOYMENT_ENVIRONMENT=production
