# Contrato de variables para preview/staging.
# No use este archivo directamente: scripts/staging/init-env.sh genera
# .staging/staging.env con permisos 0600 y secretos aleatorios o inyectados.

COMPOSE_PROJECT_NAME=inventory-staging-preview
APP_VERSION=replace-with-git-sha
STAGING_DEPLOYMENT_ID=replace-with-run-id
STAGING_LIFECYCLE=operator-managed
STAGING_VISIBILITY=host-loopback
STAGING_BIND_ADDRESS=127.0.0.1

FRONTEND_PORT=15173
BACKEND_PORT=18082
KEYCLOAK_PORT=18081
KEYCLOAK_MANAGEMENT_PORT=19000
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
ALLOY_HTTP_PORT=12346
LOKI_PORT=13100
TEMPO_PORT=13200
ALERTMANAGER_PORT=19093

STAGING_FRONTEND_URL=http://127.0.0.1:15173
STAGING_BACKEND_URL=http://127.0.0.1:18082
STAGING_KEYCLOAK_URL=http://127.0.0.1:18081

POSTGRES_DB=inventory
POSTGRES_USER=inventory_staging
POSTGRES_PASSWORD=

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak_staging
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=staging-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=inventory
KEYCLOAK_CLIENT_ID=inventory-frontend
KEYCLOAK_ADMIN_CLIENT_ID=inventory-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_IMPORT_DIR=.staging/keycloak

E2E_ADMIN_USERNAME=carlos
E2E_ADMIN_PASSWORD=
E2E_OPERATOR_USERNAME=edwin
E2E_OPERATOR_PASSWORD=
E2E_VIEWER_USERNAME=viewer
E2E_VIEWER_PASSWORD=
E2E_AUDITOR_USERNAME=auditor
E2E_AUDITOR_PASSWORD=

GRAFANA_ADMIN_USER=staging-admin
GRAFANA_ADMIN_PASSWORD=

INVENTORY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173
OTEL_SDK_DISABLED=false
OTEL_DEPLOYMENT_ENVIRONMENT=staging
