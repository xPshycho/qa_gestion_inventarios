{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xPshycho/qa_gestion_inventarios/test-summary.schema.json",
  "title": "Inventory test suite summary",
  "type": "object",
  "required": [
    "schemaVersion",
    "suite",
    "status",
    "generatedAt",
    "junit",
    "evidence",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)+$" },
    "status": {
      "enum": ["passed", "failed", "cancelled", "unknown"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "junit": {
      "type": "object",
      "required": [
        "files",
        "tests",
        "failures",
        "errors",
        "skipped",
        "durationSeconds"
      ]
    },
    "evidence": { "type": "array" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
