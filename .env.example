# Contrato local. Los secretos se generan en .env (ignorado) mediante:
# ./scripts/security/init-secret-env.sh local

COMPOSE_PROJECT_NAME=inventory-platform

POSTGRES_DB=inventory
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=inventory
KEYCLOAK_CLIENT_ID=inventory-frontend
KEYCLOAK_BACKEND_CLIENT_ID=inventory-backend
KEYCLOAK_ADMIN_CLIENT_ID=inventory-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_PORT=8081
# URL publica que utiliza el navegador y que aparece como issuer en los JWT.
KEYCLOAK_URL=http://localhost:8081

E2E_ADMIN_USERNAME=carlos
E2E_ADMIN_PASSWORD=
E2E_OPERATOR_USERNAME=edwin
E2E_OPERATOR_PASSWORD=
E2E_VIEWER_USERNAME=viewer
E2E_VIEWER_PASSWORD=
E2E_AUDITOR_USERNAME=auditor
E2E_AUDITOR_PASSWORD=

BACKEND_PORT=8080
FRONTEND_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
ALLOY_HTTP_PORT=12345
LOKI_PORT=3100
TEMPO_PORT=3200
ALERTMANAGER_PORT=9093

# El stack principal incluye Alloy, Loki y Tempo; mantener activo para trazas.
OTEL_SDK_DISABLED=false
OTEL_DEPLOYMENT_ENVIRONMENT=development
