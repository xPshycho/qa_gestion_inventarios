# Valores locales base. Copiar a .env y no commitear secretos reales.

COMPOSE_PROJECT_NAME=inventory-platform

POSTGRES_DB=inventory
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=cambiar
POSTGRES_PORT=55432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=inventory
KEYCLOAK_CLIENT_ID=inventory-frontend
KEYCLOAK_BACKEND_CLIENT_ID=inventory-backend
KEYCLOAK_PORT=8081
# URL publica que utiliza el navegador y que aparece como issuer en los JWT.
KEYCLOAK_URL=http://localhost:8081

BACKEND_PORT=8080
FRONTEND_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Deshabilitado por defecto porque el stack local aun no incluye collector OTLP.
# Las metricas Prometheus se exponen por Actuator aunque OpenTelemetry este deshabilitado.
OTEL_SDK_DISABLED=true
